<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="base.lang_ar" model="res.lang">
        <field name="active" eval="True"/>
    </record>
    <record id="base.lang_en" model="res.lang">
        <field name="active" eval="True"/>
    </record>
    <record id="website.default_website" model="website">
        <field name="default_lang_id" ref="base.lang_ar"/>
        <field name="language_ids" eval="[(6, 0, [ref('base.lang_ar'), ref('base.lang_en')])]"/>
    </record>
</odoo>
