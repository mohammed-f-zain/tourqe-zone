<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="page_home" name="Home">
        <t t-call="torque_zone_shop.website_layout">
            <t t-set="website_obj" t-value="request.website"/>
            <section class="tz-hero">
                <div class="tz-wrap tz-hero-grid">
                    <div class="tz-hero-copy tz-fade">
                        <p class="tz-label" t-esc="ui['hero_label']"/>
                        <h1><t t-esc="ui['hero_title_1']"/><br/><span t-esc="ui['hero_title_2']"/></h1>
                        <p class="tz-lead" t-esc="ui['hero_lead']"/>
                        <div class="tz-hero-btns">
                            <a href="/shop" class="tz-btn tz-btn-fill tz-btn-lg" t-esc="ui['shop_now']"/>
                            <a href="tel:0790182722" class="tz-btn tz-btn-line tz-btn-lg" t-esc="ui['call_us']"/>
                        </div>
                    </div>
                    <div class="tz-hero-visual tz-fade" style="--d:100ms">
                        <img t-att-src="'/web/image/website/%s/logo' % website_obj.id" alt="Torque Zone"/>
                    </div>
                </div>
            </section>

            <section class="tz-band">
                <div class="tz-wrap tz-band-grid">
                    <div class="tz-band-item tz-fade">
                        <b>💵</b>
                        <div><strong t-esc="ui['cod_title']"/><span t-esc="ui['cod_sub']"/></div>
                    </div>
                    <div class="tz-band-item tz-fade" style="--d:60ms">
                        <b>📦</b>
                        <div><strong t-esc="ui['inventory_title']"/><span t-esc="ui['inventory_sub']"/></div>
                    </div>
                    <div class="tz-band-item tz-fade" style="--d:120ms">
                        <b>🚚</b>
                        <div><strong t-esc="ui['delivery_title']"/><span t-esc="ui['delivery_sub']"/></div>
                    </div>
                </div>
            </section>

            <section class="tz-block tz-wrap" t-if="categories">
                <div class="tz-block-head tz-fade">
                    <h2 t-esc="ui['shop_by_category']"/>
                    <a href="/shop" class="tz-more"><t t-esc="ui['view_all']"/> →</a>
                </div>
                <div class="tz-cats">
                    <a t-foreach="categories" t-as="item" t-key="item['category'].id"
                       t-attf-href="/shop/category/#{item['category'].id}"
                       class="tz-cat tz-fade" t-attf-style="--d:#{item_index * 40}ms">
                        <strong t-esc="item['category'].name"/>
                        <span><t t-esc="item['count']"/> <t t-esc="ui['items']"/></span>
                    </a>
                </div>
            </section>

            <section class="tz-block tz-block-alt" t-if="featured_products">
                <div class="tz-wrap">
                    <div class="tz-block-head tz-fade"><h2 t-esc="ui['featured']"/></div>
                    <div class="tz-grid">
                        <t t-foreach="featured_products" t-as="product">
                            <t t-call="torque_zone_shop.product_card">
                                <t t-set="delay" t-value="product_index * 50"/>
                            </t>
                        </t>
                    </div>
                </div>
            </section>

            <section class="tz-cta tz-fade">
                <div class="tz-wrap tz-cta-inner">
                    <h2 t-esc="ui['cta_title']"/>
                    <p t-esc="ui['cta_lead']"/>
                    <a href="/shop" class="tz-btn tz-btn-white tz-btn-lg" t-esc="ui['start_shopping']"/>
                </div>
            </section>
        </t>
    </template>

    <template id="page_about" name="About Us">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-fade">
                <div class="tz-wrap">
                    <h1 t-esc="ui['about_title']"/>
                    <p t-esc="ui['about_sub']"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-split tz-fade">
                    <div class="tz-panel tz-panel-accent">
                        <h2 t-esc="ui['about_h2']"/>
                        <p t-esc="ui['about_p']"/>
                        <a href="/shop" class="tz-btn tz-btn-fill" t-esc="ui['browse_shop']"/>
                    </div>
                    <div class="tz-features">
                        <div class="tz-feat">
                            <span>01</span>
                            <div><h3 t-esc="ui['feat_trust']"/><p t-esc="ui['feat_trust_p']"/></div>
                        </div>
                        <div class="tz-feat">
                            <span>02</span>
                            <div><h3 t-esc="ui['feat_service']"/><p t-esc="ui['feat_service_p']"/></div>
                        </div>
                        <div class="tz-feat">
                            <span>03</span>
                            <div><h3 t-esc="ui['feat_delivery']"/><p t-esc="ui['feat_delivery_p']"/></div>
                        </div>
                    </div>
                </div>
            </section>
            <section class="tz-cta tz-cta-sm tz-fade">
                <div class="tz-wrap tz-cta-inner">
                    <h2 t-esc="ui['cta_title']"/>
                    <a href="/shop" class="tz-btn tz-btn-white tz-btn-lg" t-esc="ui['start_shopping']"/>
                </div>
            </section>
        </t>
    </template>
</odoo>
