<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Remove Odoo default header/footer — we use our own in website_layout -->
    <template id="tzw_hide_odoo_chrome" inherit_id="website.layout" name="Hide Odoo chrome" priority="99">
        <xpath expr="//header[@id='top']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//footer[@id='bottom']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
