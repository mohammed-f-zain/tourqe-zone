<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_category_form_torque_shop" model="ir.ui.view">
        <field name="name">product.category.form.torque.shop</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="tz_website_description" placeholder="Short text for the shop category page"/>
            </xpath>
        </field>
    </record>
</odoo>
