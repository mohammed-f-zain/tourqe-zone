<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="qty_stepper" name="Quantity Stepper">
        <div class="tz-qty" data-qty-stepper="1">
            <button type="button" class="tz-qty-btn tz-qty-minus" aria-label="Decrease">−</button>
            <span class="tz-qty-val" t-esc="qty"/>
            <button type="button" class="tz-qty-btn tz-qty-plus" aria-label="Increase">+</button>
            <input type="hidden" name="qty" t-att-value="qty" class="tz-qty-input"/>
        </div>
    </template>

    <template id="cart_qty_controls" name="Cart Quantity Controls">
        <div class="tz-qty tz-qty-cart">
            <form action="/shop/cart/qty" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="product_id" t-att-value="line['product_id']"/>
                <input type="hidden" name="action" value="dec"/>
                <button type="submit" class="tz-qty-btn" aria-label="Decrease">−</button>
            </form>
            <span class="tz-qty-val" t-esc="line['qty']"/>
            <form action="/shop/cart/qty" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <input type="hidden" name="product_id" t-att-value="line['product_id']"/>
                <input type="hidden" name="action" value="inc"/>
                <button type="submit" class="tz-qty-btn" aria-label="Increase">+</button>
            </form>
        </div>
    </template>

    <template id="shop_catalog" name="Shop Catalog">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-fade">
                <div class="tz-wrap">
                    <p class="tz-label">Shop</p>
                    <h1 t-if="is_rtl and not category">المتجر</h1>
                    <h1 t-elif="not category">Shop</h1>
                    <h1 t-else="" t-esc="category.name"/>
                    <p t-if="is_rtl">تصفح المنتجات · أضف للسلة · ادفع عند الاستلام</p>
                    <p t-else="">Browse products · Add to cart · Pay on delivery</p>
                </div>
            </section>

            <section class="tz-block tz-wrap">
                <div class="tz-toolbar tz-fade">
                    <form class="tz-search" action="/shop" method="get">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                        <input type="search" name="search" placeholder="Search products…" t-att-value="search or ''"/>
                        <button type="submit" class="tz-btn tz-btn-fill tz-btn-sm">Search</button>
                    </form>
                    <t t-call="torque_zone_shop.shop_category_pills"/>
                </div>

                <div class="tz-meta tz-fade" t-if="products">
                    <span><strong t-esc="len(products)"/> products</span>
                    <span class="tz-badge">Cash on Delivery</span>
                </div>

                <div class="tz-grid" t-if="products">
                    <t t-foreach="products" t-as="product">
                        <t t-call="torque_zone_shop.product_card">
                            <t t-set="delay" t-value="product_index * 50"/>
                        </t>
                    </t>
                </div>

                <div class="tz-empty tz-fade" t-else="">
                    <span>📦</span>
                    <h3>No products found</h3>
                    <a href="/shop" class="tz-btn tz-btn-fill">View All</a>
                </div>

                <div class="tz-pager tz-fade" t-if="total_pages > 1">
                    <a t-if="page > 1" t-attf-href="/shop/page/#{page - 1}" class="tz-btn tz-btn-line tz-btn-sm">← Prev</a>
                    <span><t t-esc="page"/> / <t t-esc="total_pages"/></span>
                    <a t-if="page &lt; total_pages" t-attf-href="/shop/page/#{page + 1}" class="tz-btn tz-btn-line tz-btn-sm">Next →</a>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_product" name="Product Detail">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-top-sm tz-fade">
                <div class="tz-wrap">
                    <a href="/shop" class="tz-back">← Back to shop</a>
                    <span class="tz-badge" t-if="product.categ_id" t-esc="product.categ_id.name"/>
                    <h1 t-esc="product.name"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-pdp tz-fade">
                    <div class="tz-pdp-img">
                        <img t-att-src="image_url" t-att-alt="product.name"/>
                    </div>
                    <div class="tz-pdp-info">
                        <p class="tz-price tz-price-lg">
                            <t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                        </p>
                        <p class="tz-pdp-desc" t-if="product.description_sale" t-esc="product.description_sale"/>
                        <div class="tz-badge tz-badge-block">💵 Cash on delivery</div>
                        <form action="/shop/cart/add" method="post" class="tz-pdp-form">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="product_id" t-att-value="product.id"/>
                            <div class="tz-field-row">
                                <label>Quantity</label>
                                <t t-call="torque_zone_shop.qty_stepper">
                                    <t t-set="qty" t-value="1"/>
                                </t>
                            </div>
                            <input type="hidden" name="redirect" value="/shop/cart"/>
                            <button type="submit" class="tz-btn tz-btn-fill tz-btn-lg tz-btn-wide">Add to Cart</button>
                        </form>
                    </div>
                </div>
            </section>
            <section class="tz-block tz-block-alt" t-if="related_products">
                <div class="tz-wrap">
                    <h2 class="tz-block-title tz-fade">Related Products</h2>
                    <div class="tz-grid">
                        <t t-foreach="related_products" t-as="product">
                            <t t-call="torque_zone_shop.product_card"/>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_cart" name="Cart">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-top-sm tz-fade">
                <div class="tz-wrap">
                    <h1 t-if="is_rtl">سلتك</h1>
                    <h1 t-else="">Your Cart</h1>
                    <t t-call="torque_zone_shop.journey_steps"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-checkout" t-if="lines">
                    <div class="tz-cart-list">
                        <t t-foreach="lines" t-as="line">
                            <div class="tz-cart-item tz-fade" t-attf-style="--d:#{line_index * 60}ms">
                                <img t-att-src="line['image_url']" t-att-alt="line['name']"/>
                                <div class="tz-cart-item-body">
                                    <h3 t-esc="line['name']"/>
                                    <p class="tz-price">
                                        <t t-esc="line['price']" t-options="{'widget': 'monetary', 'display_currency': line['product'].currency_id}"/>
                                    </p>
                                    <t t-call="torque_zone_shop.cart_qty_controls"/>
                                </div>
                                <div class="tz-cart-item-end">
                                    <p class="tz-price">
                                        <t t-esc="line['subtotal']" t-options="{'widget': 'monetary', 'display_currency': line['product'].currency_id}"/>
                                    </p>
                                    <a t-attf-href="/shop/cart/remove/#{line['product_id']}" class="tz-remove" title="Remove">✕</a>
                                </div>
                            </div>
                        </t>
                    </div>
                    <aside class="tz-summary tz-fade" style="--d:100ms">
                        <h2>Order Summary</h2>
                        <div class="tz-summary-row">
                            <span>Subtotal</span>
                            <span><t t-esc="total" t-options="{'widget': 'monetary', 'display_currency': lines[0]['product'].currency_id}"/></span>
                        </div>
                        <div class="tz-summary-row"><span>Payment</span><span class="tz-badge">Cash on Delivery</span></div>
                        <a href="/shop/checkout" class="tz-btn tz-btn-fill tz-btn-wide tz-btn-lg">Checkout →</a>
                        <a href="/shop" class="tz-btn tz-btn-line tz-btn-wide">Continue Shopping</a>
                    </aside>
                </div>
                <div class="tz-empty tz-fade" t-else="">
                    <span>🛒</span>
                    <h3>Your cart is empty</h3>
                    <p>Browse our shop and add tools to get started.</p>
                    <a href="/shop" class="tz-btn tz-btn-fill">Browse Shop</a>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_checkout" name="Checkout">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-top-sm tz-fade">
                <div class="tz-wrap">
                    <h1 t-if="is_rtl">إتمام الطلب</h1>
                    <h1 t-else="">Checkout</h1>
                    <p t-if="is_rtl">الدفع عند الاستلام</p>
                    <p t-else="">Cash on delivery</p>
                    <t t-call="torque_zone_shop.journey_steps"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-alert tz-fade" t-if="errors">
                    <t t-foreach="errors" t-as="err"><p t-esc="err"/></t>
                </div>
                <div class="tz-checkout">
                    <form action="/shop/order/confirm" method="post" class="tz-form tz-fade">
                        <h2 t-if="is_rtl">بيانات التوصيل</h2>
                        <h2 t-else="">Delivery Details</h2>
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="tz-field">
                            <label for="customer_name">Full Name *</label>
                            <input type="text" id="customer_name" name="customer_name" required="required"
                                   t-att-value="form and form.get('customer_name') or ''"/>
                        </div>
                        <div class="tz-field">
                            <label for="phone_number">Phone Number *</label>
                            <input type="tel" id="phone_number" name="phone_number" required="required"
                                   placeholder="07X XXX XXXX" t-att-value="form and form.get('phone_number') or ''"/>
                        </div>
                        <div class="tz-field">
                            <label for="address">Delivery Address *</label>
                            <textarea id="address" name="address" required="required" rows="3"
                                      placeholder="Street, building, area…"
                                      t-esc="form and form.get('address') or ''"/>
                        </div>
                        <div class="tz-field">
                            <label for="city">City *</label>
                            <select id="city" name="city" required="required">
                                <option value="">Select your city</option>
                                <t t-foreach="jordan_cities" t-as="c">
                                    <option t-att-value="c[0]" t-esc="c[1]"
                                            t-att-selected="form and form.get('city') == c[0] and 'selected' or None"/>
                                </t>
                            </select>
                        </div>
                        <button type="submit" class="tz-btn tz-btn-fill tz-btn-lg tz-btn-wide">Place Order</button>
                    </form>
                    <aside class="tz-summary tz-fade" style="--d:80ms">
                        <h2>Your Order</h2>
                        <t t-foreach="lines" t-as="line">
                            <div class="tz-summary-line">
                                <span><t t-esc="line['qty']"/>× <t t-esc="line['name']"/></span>
                                <span><t t-esc="line['subtotal']" t-options="{'widget': 'monetary', 'display_currency': line['product'].currency_id}"/></span>
                            </div>
                        </t>
                        <div class="tz-summary-row tz-summary-total">
                            <span>Total</span>
                            <span><t t-esc="total" t-options="{'widget': 'monetary', 'display_currency': lines[0]['product'].currency_id}"/></span>
                        </div>
                        <p class="tz-hint">💵 Pay cash when your order arrives</p>
                    </aside>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_confirmation" name="Order Confirmation">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-top-sm tz-fade">
                <div class="tz-wrap">
                    <t t-call="torque_zone_shop.journey_steps"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-confirm tz-fade">
                    <div class="tz-confirm-icon">✓</div>
                    <h1>Order Placed!</h1>
                    <p class="tz-confirm-ref">Order <strong t-esc="order.name"/></p>
                    <p>We'll call <strong t-esc="order.delivery_phone"/> to confirm.</p>
                    <p><strong t-esc="address_label"/> · <strong t-esc="city_label"/></p>
                    <div class="tz-badge tz-badge-block">Pay cash when your order arrives</div>
                    <div class="tz-confirm-btns">
                        <a href="/shop" class="tz-btn tz-btn-fill">Continue Shopping</a>
                        <a href="/" class="tz-btn tz-btn-line">Back to Home</a>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
