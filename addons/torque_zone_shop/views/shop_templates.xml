<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="qty_stepper" name="Quantity Stepper">
        <div class="tz-qty" data-qty-stepper="1" t-att-data-max-qty="max_qty if max_qty is not None else 9999">
            <button type="button" class="tz-qty-btn tz-qty-minus" t-att-aria-label="ui['decrease']">−</button>
            <span class="tz-qty-val" t-esc="qty"/>
            <button type="button" class="tz-qty-btn tz-qty-plus" t-att-aria-label="ui['increase']">+</button>
            <input type="hidden" name="qty" t-att-value="qty" class="tz-qty-input"/>
        </div>
    </template>

    <template id="cart_qty_controls" name="Cart Quantity Controls">
        <div class="tz-qty tz-qty-cart" t-att-data-product-id="line['product_id']" t-att-data-max-qty="line['max_qty']">
            <button type="button" class="tz-qty-btn" data-action="dec" t-att-aria-label="ui['decrease']">−</button>
            <span class="tz-qty-val" t-esc="line['qty']"/>
            <button type="button" class="tz-qty-btn" data-action="inc" t-att-aria-label="ui['increase']">+</button>
        </div>
    </template>

    <template id="shop_catalog" name="Shop Catalog">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-fade">
                <div class="tz-wrap">
                    <p class="tz-label" t-esc="ui['shop_label']"/>
                    <h1 t-if="category" t-esc="category.name"/>
                    <h1 t-else="" t-esc="ui['shop_title']"/>
                    <p t-if="category and category.tz_website_description" t-esc="category.tz_website_description"/>
                    <p t-else="" t-esc="ui['shop_lead']"/>
                </div>
            </section>

            <section class="tz-block tz-wrap">
                <div class="tz-toolbar tz-fade">
                    <form class="tz-shop-filters" method="get"
                          t-att-action="category_id and '/shop/category/%s' % category_id or '/shop'">
                        <div class="tz-search">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                            <input type="search" name="search" t-att-placeholder="ui['search_ph']" t-att-value="search or ''"/>
                        </div>
                        <select name="sort" class="tz-sort" onchange="this.form.submit()">
                            <option value="name" t-att-selected="sort == 'name' and 'selected' or None" t-esc="ui['sort_name']"/>
                            <option value="price_asc" t-att-selected="sort == 'price_asc' and 'selected' or None" t-esc="ui['sort_price_asc']"/>
                            <option value="price_desc" t-att-selected="sort == 'price_desc' and 'selected' or None" t-esc="ui['sort_price_desc']"/>
                        </select>
                        <button type="submit" class="tz-btn tz-btn-fill tz-btn-sm" t-esc="ui['apply']"/>
                    </form>
                    <t t-call="torque_zone_shop.shop_category_pills"/>
                </div>

                <div class="tz-meta tz-fade" t-if="products">
                    <span><strong t-esc="product_total or len(products)"/> <t t-esc="ui['products_count']"/></span>
                    <span class="tz-badge" t-esc="ui['cod']"/>
                </div>

                <div class="tz-grid" t-if="products">
                    <t t-foreach="products" t-as="product">
                        <t t-call="torque_zone_shop.product_card">
                            <t t-set="delay" t-value="product_index * 50"/>
                        </t>
                    </t>
                </div>

                <div class="tz-empty tz-fade" t-else="">
                    <span>📦</span>
                    <h3 t-esc="ui['no_products']"/>
                    <a href="/shop" class="tz-btn tz-btn-fill" t-esc="ui['view_all']"/>
                </div>

                <div class="tz-pager tz-fade" t-if="total_pages > 1">
                    <t t-set="query" t-value="'search=%s&amp;sort=%s' % (search or '', sort or 'name')"/>
                    <t t-set="page_base" t-value="category_id and '/shop/category/%s/page' % category_id or '/shop/page'"/>
                    <a t-if="page > 1" t-attf-href="#{page_base}/#{page - 1}?#{query}" class="tz-btn tz-btn-line tz-btn-sm" t-esc="ui['prev']"/>
                    <span><t t-esc="page"/> / <t t-esc="total_pages"/></span>
                    <a t-if="page &lt; total_pages" t-attf-href="#{page_base}/#{page + 1}?#{query}" class="tz-btn tz-btn-line tz-btn-sm" t-esc="ui['next']"/>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_product" name="Product Detail">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-pdp-page tz-wrap">
                <nav class="tz-pdp-crumb tz-fade">
                    <a href="/shop" class="tz-back" t-esc="ui['back_shop']"/>
                    <span t-if="product.categ_id"> / <t t-esc="product.categ_id.name"/></span>
                </nav>

                <div class="tz-pdp-layout tz-fade">
                    <div class="tz-pdp-gallery">
                        <div class="tz-pdp-stage">
                            <img id="tzPdpMain" t-att-src="images[0]['url']" t-att-alt="product.name"/>
                        </div>
                        <div class="tz-pdp-thumbs" t-if="len(images) > 1">
                            <button type="button"
                                    t-foreach="images" t-as="img"
                                    t-att-class="'tz-pdp-thumb' + (' is-active' if img_index == 0 else '')"
                                    t-att-data-src="img['url']"
                                    t-att-aria-label="img['name']">
                                <img t-att-src="img['url']" t-att-alt="img['name']"/>
                            </button>
                        </div>
                    </div>

                    <aside class="tz-pdp-panel">
                        <span class="tz-badge" t-if="product.categ_id" t-esc="product.categ_id.name"/>
                        <h1 class="tz-pdp-title" t-esc="product.name"/>
                        <p class="tz-price tz-price-lg tz-pdp-price">
                            <t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                        </p>
                        <div class="tz-pdp-trust">
                            <span class="tz-badge" t-esc="ui['cod']"/>
                            <span class="tz-badge tz-badge-out" t-if="tracks_stock and stock_max &lt;= 0" t-esc="ui['out_of_stock']"/>
                            <span class="tz-badge" t-elif="tracks_stock and stock_max &gt; 0" t-esc="ui['in_stock']"/>
                            <span class="tz-badge" t-elif="not tracks_stock" t-esc="ui['in_stock']"/>
                        </div>
                        <p class="tz-stock-note" t-if="tracks_stock and stock_max &gt; 0 and stock_max &lt;= 10">
                            <t t-esc="ui['stock_left'] % stock_max"/>
                        </p>

                        <form t-if="stock_max &gt; 0 or not tracks_stock"
                              t-attf-action="#{request.env['ir.http']._url_for('/shop/cart/add')}"
                              method="post" class="tz-pdp-buy tz-add-cart-form" data-tz-add-cart="1">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="product_id" t-att-value="product.id"/>
                            <div class="tz-field-row">
                                <label t-esc="ui['quantity']"/>
                                <t t-call="torque_zone_shop.qty_stepper">
                                    <t t-set="qty" t-value="1"/>
                                    <t t-set="max_qty" t-value="stock_max if tracks_stock else 9999"/>
                                </t>
                            </div>
                            <input type="hidden" name="redirect" t-att-value="request.env['ir.http']._url_for('/shop/cart')"/>
                            <button type="submit" class="tz-btn tz-btn-fill tz-btn-lg tz-btn-wide" t-esc="ui['add_to_cart']"/>
                        </form>
                        <p class="tz-stock-note tz-stock-out" t-else="" t-esc="ui['out_of_stock']"/>

                        <div class="tz-pdp-desc-block" t-if="product.description_sale or product.description">
                            <h2 t-esc="ui['description']"/>
                            <p class="tz-pdp-desc" t-if="product.description_sale" t-esc="product.description_sale"/>
                            <div class="tz-pdp-desc-html" t-if="product.description" t-out="product.description"/>
                        </div>
                    </aside>
                </div>
            </section>

            <section class="tz-block tz-block-alt" t-if="related_products">
                <div class="tz-wrap">
                    <h2 class="tz-block-title tz-fade" t-esc="ui['related']"/>
                    <div class="tz-grid">
                        <t t-foreach="related_products" t-as="product">
                            <t t-call="torque_zone_shop.product_card"/>
                        </t>
                    </div>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_cart" name="Cart">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-top-sm tz-fade">
                <div class="tz-wrap">
                    <h1 t-esc="ui['your_cart']"/>
                    <t t-call="torque_zone_shop.journey_steps"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-checkout" t-if="lines">
                    <div class="tz-cart-list">
                        <t t-foreach="lines" t-as="line">
                            <div class="tz-cart-item tz-fade" t-att-data-product-id="line['product_id']" t-attf-style="--d:#{line_index * 60}ms">
                                <img t-att-src="line['image_url']" t-att-alt="line['name']"/>
                                <div class="tz-cart-item-body">
                                    <h3 t-esc="line['name']"/>
                                    <p class="tz-price">
                                        <t t-esc="line['price']" t-options="{'widget': 'monetary', 'display_currency': line['product'].currency_id}"/>
                                    </p>
                                    <p class="tz-stock-note" t-if="line['tracks_stock']">
                                        <t t-esc="ui['stock_left'] % line['max_qty']"/>
                                    </p>
                                    <t t-call="torque_zone_shop.cart_qty_controls"/>
                                </div>
                                <div class="tz-cart-item-end">
                                    <p class="tz-price tz-line-subtotal">
                                        <t t-esc="line['subtotal']" t-options="{'widget': 'monetary', 'display_currency': line['product'].currency_id}"/>
                                    </p>
                                    <button type="button" class="tz-remove" t-att-data-product-id="line['product_id']"
                                            t-att-title="ui['remove']" t-att-aria-label="ui['remove']">✕</button>
                                </div>
                            </div>
                        </t>
                    </div>
                    <aside class="tz-summary tz-fade" style="--d:100ms">
                        <h2 t-esc="ui['order_summary']"/>
                        <div class="tz-summary-row">
                            <span t-esc="ui['subtotal']"/>
                            <span id="tzCartTotal"><t t-esc="total" t-options="{'widget': 'monetary', 'display_currency': lines[0]['product'].currency_id}"/></span>
                        </div>
                        <div class="tz-summary-row">
                            <span t-esc="ui['payment']"/>
                            <span class="tz-badge" t-esc="ui['cod']"/>
                        </div>
                        <a href="/shop/checkout" class="tz-btn tz-btn-fill tz-btn-wide tz-btn-lg" t-esc="ui['checkout']"/>
                        <a href="/shop" class="tz-btn tz-btn-line tz-btn-wide" t-esc="ui['continue_shopping']"/>
                    </aside>
                </div>
                <div class="tz-empty tz-fade" id="tzCartEmpty" t-else="">
                    <span>🛒</span>
                    <h3 t-esc="ui['cart_empty']"/>
                    <p t-esc="ui['cart_empty_p']"/>
                    <a href="/shop" class="tz-btn tz-btn-fill" t-esc="ui['browse_shop']"/>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_checkout" name="Checkout">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-top-sm tz-fade">
                <div class="tz-wrap">
                    <h1 t-esc="ui['checkout_title']"/>
                    <p t-esc="ui['cod']"/>
                    <t t-call="torque_zone_shop.journey_steps"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-alert tz-fade" t-if="errors">
                    <t t-foreach="errors" t-as="err"><p t-esc="err"/></t>
                </div>
                <div class="tz-checkout">
                    <form action="/shop/order/confirm" method="post" class="tz-form tz-fade">
                        <h2 t-esc="ui['delivery_details']"/>
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="tz-field">
                            <label for="customer_name" t-esc="ui['full_name']"/>
                            <input type="text" id="customer_name" name="customer_name" required="required"
                                   t-att-value="form and form.get('customer_name') or ''"/>
                        </div>
                        <div class="tz-field">
                            <label for="phone_number" t-esc="ui['phone']"/>
                            <input type="tel" id="phone_number" name="phone_number" required="required"
                                   placeholder="07X XXX XXXX" t-att-value="form and form.get('phone_number') or ''"/>
                        </div>
                        <div class="tz-field">
                            <label for="address" t-esc="ui['address']"/>
                            <textarea id="address" name="address" required="required" rows="3"
                                      t-att-placeholder="ui['address_ph']"
                                      t-esc="form and form.get('address') or ''"/>
                        </div>
                        <div class="tz-field">
                            <label for="city" t-esc="ui['city']"/>
                            <select id="city" name="city" required="required">
                                <option value="" t-esc="ui['city_ph']"/>
                                <t t-foreach="jordan_cities" t-as="c">
                                    <option t-att-value="c[0]" t-esc="c[1]"
                                            t-att-selected="form and form.get('city') == c[0] and 'selected' or None"/>
                                </t>
                            </select>
                        </div>
                        <button type="submit" class="tz-btn tz-btn-fill tz-btn-lg tz-btn-wide" t-esc="ui['place_order']"/>
                    </form>
                    <aside class="tz-summary tz-fade" style="--d:80ms">
                        <h2 t-esc="ui['your_order']"/>
                        <t t-foreach="lines" t-as="line">
                            <div class="tz-summary-line">
                                <span><t t-esc="line['qty']"/>× <t t-esc="line['name']"/></span>
                                <span><t t-esc="line['subtotal']" t-options="{'widget': 'monetary', 'display_currency': line['product'].currency_id}"/></span>
                            </div>
                        </t>
                        <div class="tz-summary-row tz-summary-total">
                            <span t-esc="ui['total']"/>
                            <span><t t-esc="total" t-options="{'widget': 'monetary', 'display_currency': lines[0]['product'].currency_id}"/></span>
                        </div>
                        <p class="tz-hint" t-esc="ui['pay_hint']"/>
                    </aside>
                </div>
            </section>
        </t>
    </template>

    <template id="shop_confirmation" name="Order Confirmation">
        <t t-call="torque_zone_shop.website_layout">
            <section class="tz-top tz-top-sm tz-fade">
                <div class="tz-wrap">
                    <t t-call="torque_zone_shop.journey_steps"/>
                </div>
            </section>
            <section class="tz-block tz-wrap">
                <div class="tz-confirm tz-fade">
                    <div class="tz-confirm-icon">✓</div>
                    <h1 t-esc="ui['order_placed']"/>
                    <p class="tz-confirm-ref">Order <strong t-esc="order.name"/></p>
                    <p><t t-esc="ui['order_confirm_call']"/> <strong t-esc="order.delivery_phone"/> <t t-esc="ui['order_confirm_to']"/></p>
                    <p><strong t-esc="address_label"/> · <strong t-esc="city_label"/></p>
                    <div class="tz-badge tz-badge-block" t-esc="ui['pay_on_arrival']"/>
                    <div class="tz-confirm-btns">
                        <a href="/shop" class="tz-btn tz-btn-fill" t-esc="ui['continue_shopping']"/>
                        <a href="/" class="tz-btn tz-btn-line" t-esc="ui['back_home']"/>
                    </div>
                </div>
            </section>
        </t>
    </template>
</odoo>
