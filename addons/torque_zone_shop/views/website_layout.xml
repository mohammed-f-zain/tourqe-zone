<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_layout" name="Torque Zone Website">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="website_obj" t-value="request.website"/>
            <t t-set="current_path" t-value="request.httprequest.path"/>
            <div id="tz_website" class="tz" t-att-data-page="active_page or ''"
                 t-att-dir="'rtl' if is_rtl else 'ltr'">

                <header class="tz-header" id="tzHeader">
                    <div class="tz-wrap tz-header-inner">
                        <a href="/" class="tz-logo-link">
                            <img t-att-src="'/web/image/website/%s/logo' % website_obj.id"
                                 alt="Torque Zone" class="tz-logo"/>
                        </a>
                        <button class="tz-burger" id="tzBurger" type="button" t-att-aria-label="ui['menu']">
                            <span/><span/><span/>
                        </button>
                        <nav class="tz-nav" id="tzNav">
                            <a href="/" t-att-class="'tz-nav-link' + (' is-active' if active_page == 'home' else '')"
                               t-esc="ui['nav_home']"/>
                            <t t-foreach="nav_categories" t-as="nav_item">
                                <div class="tz-nav-drop" t-if="nav_item['children']"
                                     t-attf-data-nav-drop="#{nav_item['category'].id}">
                                    <button type="button"
                                            t-att-class="'tz-nav-link tz-nav-drop-btn' + (' is-active' if active_page == 'shop' and category_id == nav_item['category'].id else '')">
                                        <span t-esc="nav_item['category'].name"/>
                                        <svg class="tz-nav-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 9l6 6 6-6"/></svg>
                                    </button>
                                    <div class="tz-nav-drop-menu">
                                        <a t-attf-href="/shop/category/#{nav_item['category'].id}"
                                           class="tz-nav-drop-all">
                                            <t t-esc="ui['nav_all_in']"/> <t t-esc="nav_item['category'].name"/>
                                        </a>
                                        <a t-foreach="nav_item['children']" t-as="child"
                                           t-attf-href="/shop/category/#{child.id}"
                                           t-att-class="'tz-nav-drop-link' + (' is-active' if category_id == child.id else '')"
                                           t-esc="child.name"/>
                                    </div>
                                </div>
                                <a t-else=""
                                   t-attf-href="/shop/category/#{nav_item['category'].id}"
                                   t-att-class="'tz-nav-link' + (' is-active' if active_page == 'shop' and category_id == nav_item['category'].id else '')"
                                   t-esc="nav_item['category'].name"/>
                            </t>
                            <a href="/about" t-att-class="'tz-nav-link' + (' is-active' if active_page == 'about' else '')"
                               t-esc="ui['nav_about']"/>
                        </nav>
                        <div class="tz-header-end">
                            <div class="tz-lang">
                                <a t-attf-href="/website/lang/ar_001?r=#{current_path}"
                                   t-att-class="'tz-lang-btn' + (' is-on' if is_rtl else '')">عربي</a>
                                <a t-attf-href="/website/lang/en_US?r=#{current_path}"
                                   t-att-class="'tz-lang-btn' + (' is-on' if not is_rtl else '')">EN</a>
                            </div>
                            <a href="/shop/cart" class="tz-cart">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6h15l-1.5 9H8L6 6z"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/><path d="M6 6L5 3H2"/></svg>
                                <span t-esc="ui['nav_cart']"/>
                                <em class="tz-cart-count" t-esc="cart_count or 0"/>
                            </a>
                        </div>
                    </div>
                </header>

                <main class="tz-main">
                    <t t-out="0"/>
                </main>

                <footer class="tz-footer">
                    <div class="tz-wrap tz-footer-grid">
                        <div class="tz-footer-brand">
                            <div class="tz-footer-logo-box">
                                <img t-att-src="'/web/image/website/%s/logo' % website_obj.id" alt="Torque Zone"/>
                            </div>
                            <p t-esc="ui['footer_tagline']"/>
                        </div>
                        <div>
                            <h5 t-esc="ui['footer_pages']"/>
                            <a href="/" t-esc="ui['nav_home']"/>
                            <a href="/shop" t-esc="ui['shop_title']"/>
                            <a href="/about" t-esc="ui['nav_about']"/>
                        </div>
                        <div>
                            <h5 t-esc="ui['footer_order']"/>
                            <a href="/shop" t-esc="ui['footer_products']"/>
                            <a href="/shop/cart" t-esc="ui['nav_cart']"/>
                            <a href="/shop/checkout" t-esc="ui['footer_checkout']"/>
                        </div>
                        <div>
                            <h5 t-esc="ui['footer_call']"/>
                            <a href="tel:0790182722">طارق 0790182722</a>
                            <a href="tel:0785426397">أحمد 0785426397</a>
                        </div>
                    </div>
                    <div class="tz-wrap tz-footer-bar">
                        <span>© 2026 Torque Zone</span>
                        <span>torque-zone.shop</span>
                    </div>
                </footer>
            </div>
        </t>
    </template>

    <template id="product_card" name="Product Card">
        <article class="tz-card tz-fade" t-attf-style="--d:#{delay or 0}ms">
            <a t-att-href="product.website_url" class="tz-card-img">
                <img t-att-src="product.image_512 and '/web/image/product.template/%s/image_512' % product.id or '/torque_zone_shop/static/src/img/placeholder.svg'"
                     t-att-alt="product.name" loading="lazy"/>
            </a>
            <div class="tz-card-body">
                <span class="tz-card-cat" t-if="product.categ_id" t-esc="product.categ_id.name"/>
                <h3><a t-att-href="product.website_url" t-esc="product.name"/></h3>
                <p class="tz-price">
                    <t t-esc="product.list_price" t-options="{'widget': 'monetary', 'display_currency': product.currency_id}"/>
                </p>
                <t t-set="tracks_stock" t-value="product.is_storable"/>
                <t t-set="card_max_qty" t-value="int(product.qty_available) if tracks_stock else 9999"/>
                <t t-if="tracks_stock and card_max_qty &lt;= 0">
                    <span class="tz-btn tz-btn-line tz-btn-sm tz-btn-wide tz-btn-disabled" t-esc="ui['out_of_stock']"/>
                </t>
                <form t-else="" t-attf-action="#{request.env['ir.http']._url_for('/shop/cart/add')}" method="post" class="tz-add-cart-form" data-tz-add-cart="1">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="product_id" t-att-value="product.id"/>
                    <input type="hidden" name="qty" value="1"/>
                    <input type="hidden" name="redirect" t-att-value="request.env['ir.http']._url_for('/shop/cart')"/>
                    <button type="submit" class="tz-btn tz-btn-fill tz-btn-sm tz-btn-wide" t-esc="ui['add_to_cart']"/>
                </form>
            </div>
        </article>
    </template>

    <template id="shop_category_pills" name="Category Pills">
        <t t-set="qs" t-value="'?sort=%s&amp;search=%s' % (sort or 'name', search or '')"/>
        <div class="tz-tags">
            <a t-attf-href="/shop#{qs}" t-att-class="'tz-tag' + (' is-on' if not category_id else '')" t-esc="ui['all']"/>
            <t t-foreach="categories" t-as="cat">
                <a t-attf-href="/shop/category/#{cat.id}#{qs}"
                   t-att-class="'tz-tag' + (' is-on' if category_id == cat.id else '')"
                   t-esc="cat.name"/>
            </t>
        </div>
    </template>
</odoo>
